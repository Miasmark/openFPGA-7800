# Pocket core file list.
#
# The MiSTer Atari7800 sources under ../mister/rtl are vendored; the few
# Pocket changes (build switches such as NO_DDRAM, NO_BUPCHIP and
# POCKET_BUPCHIP in rtl/top.sv, and the fixes) are listed in
# ../mister/POCKET_CHANGES.md. The macros and memory-file search paths are set
# in ap_core.qsf.

# Pocket glue
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) core_top.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) core_bridge_cmd.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll_region.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) atari7800_pocket.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) virtual_axis.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) sram_ctrl.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) stick_dirs.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) audio_filter.sv]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) pll/pll_core.qip]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/data_loader.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/sound_i2s.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/sync_fifo.sv]

# MiSTer Atari7800 core
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../mister/rtl/sdram.sv]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) ../mister/rtl/6502/mos6502.qip]
# POKEY: upstream's rtl/Pokey (since 2.0.21), with the Pocket's adapter fix
# and output level (see mister/POCKET_CHANGES.md). Mark Watson's VHDL POKEY,
# used up to 2.0.20, stays in mister/rtl/PokeyWatson for simulation.
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) ../mister/rtl/Pokey/Pokey.qip]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) ../mister/rtl/Minnie/Minnie.qip]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) ../mister/rtl/SN76489/SN76489.qip]
