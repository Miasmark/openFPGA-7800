# The Pocket's BupChip, ARIA (POCKET_BUPCHIP; docs/BUPCHIP_CORE.md), after
# arm7tdmi_pkg.sv, which bup_cpu.sv imports. psram.sv (agg23, unmodified) and
# data_loader.sv both define `MAX the same way; Quartus 21.1 accepts the
# identical redefinition without a warning.
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/psram.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_cpu.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_capture.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_asset_wr.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_asset_cache.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_tick48k.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_load_probe.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bup_status_osd.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) bupchip/bupchip_pocket.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../mister/rtl/bupchip_peripheral.sv]
